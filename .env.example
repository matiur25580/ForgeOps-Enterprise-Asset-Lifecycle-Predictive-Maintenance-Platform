# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info

# Local MongoDB (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/forgeops

# Authentication: replace with a unique random secret (at least 32 characters).
# Generate with: openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=change-this-to-a-unique-random-secret-of-32-or-more-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=14

# Optional SMTP email delivery (leave unset to keep notifications in-app only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
