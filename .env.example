# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info

# Local MongoDB (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/forgeops

# Replace with a cryptographically random secret before enabling authentication.
# This value is intentionally a placeholder and must never be used in production.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters\n# Authentication secrets: generate a unique random value of at least 32 characters.\nAUTH_ACCESS_TOKEN_SECRET=change-this-to-a-unique-random-secret-of-32-or-more-characters\nAUTH_ACCESS_TOKEN_TTL=15m\nAUTH_REFRESH_TOKEN_DAYS=14\n